#include <windows.h>
#include "version.h"

1 ICON "chisel.ico"
1 24 "Chisel.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CHISEL_WIN_VERSION_MAJOR, CHISEL_WIN_VERSION_MINOR, CHISEL_WIN_VERSION_PATCH, 0
PRODUCTVERSION CHISEL_WIN_VERSION_MAJOR, CHISEL_WIN_VERSION_MINOR, CHISEL_WIN_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Snesnopic"
            VALUE "FileDescription", "Chisel"
            VALUE "FileVersion", CHISEL_WIN_VERSION_STR
            VALUE "InternalName", "Chisel"
            VALUE "OriginalFilename", "Chisel.exe"
            VALUE "ProductName", "Chisel"
            VALUE "ProductVersion", CHISEL_WIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
